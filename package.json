{
  "name": "jaasim-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Mohamed Jaasim's personal portfolio: a scroll-told story with a guided and a free-scroll mode.",
  "author": "Mohamed Jaasim",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "photos": "node scripts/optimize-photos.mjs",
    "test:dev": "playwright test -c playwright.dev.config.ts"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serve": "^10.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
